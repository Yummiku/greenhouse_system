page { background:#f5f7f5;color:#203b32;font-size:28rpx; }
.page { padding:28rpx; }
.card { background:white;border:1rpx solid #d7e3dc;padding:24rpx;margin-bottom:20rpx; }
.title { font-size:34rpx;font-weight:600;margin-bottom:18rpx; }
.muted { color:#66776e;font-size:25rpx; }
.error { color:#a02222;white-space:pre-wrap; }
.line { margin:14rpx 0;overflow-wrap:anywhere;white-space:pre-wrap; }
button { margin:16rpx 0;font-size:28rpx; }
.primary { background:#137d42;color:white; }
input,picker { border:1rpx solid #cddbd2;padding:18rpx;margin:12rpx 0; }
label { display:block;margin-top:18rpx; }
