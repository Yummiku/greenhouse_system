<view class="page"><view class="card"><view class="title">报警事件</view><label>大棚</label><picker range="{{houses}}" range-key="label" value="{{houseIndex}}" data-field="greenhouseId" bindchange="pick">{{houses[houseIndex].label}}</picker><label>指标</label><picker range="{{metricLabels}}" value="{{metricIndex}}" data-field="metric" bindchange="pick">{{metricLabels[metricIndex]}}</picker><label>状态</label><picker range="{{stateLabels}}" value="{{stateIndex}}" data-field="state" bindchange="pick">{{stateLabels[stateIndex]}}</picker><label>来源</label><picker range="{{sourceLabels}}" value="{{sourceIndex}}" data-field="source" bindchange="pick">{{sourceLabels[sourceIndex]}}</picker><label>首次触发起日</label><picker mode="date" value="{{draft.start}}" data-field="start" bindchange="date">{{draft.start || '不限'}}</picker><label>首次触发止日</label><picker mode="date" value="{{draft.end}}" data-field="end" bindchange="date">{{draft.end || '不限'}}</picker><button class="primary" bindtap="query" disabled="{{busy}}">查询</button><button bindtap="reset" disabled="{{busy}}">重置</button><button bindtap="refresh" disabled="{{busy}}">刷新</button><button wx:if="{{optionsError}}" bindtap="loadOptions" disabled="{{busy}}">重试加载大棚</button><view class="error">{{error}}</view><button wx:if="{{error}}" bindtap="refresh" disabled="{{busy}}">重试读取</button><view wx:if="{{loaded}}">共{{total}}个事件，已加载{{items.length}}条</view></view><view wx:if="{{busy}}">正在读取…</view><view wx:if="{{loaded &amp;&amp; !total}}" class="card">当前条件下暂无报警事件</view><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="title">{{item.greenhouse_name}}（{{item.greenhouse_code}}）</view><view class="line">事件{{item.id}} · {{item.metric_label}} · {{item.state_label}}</view><view class="line">首次 {{item.first_sample_value}}{{item.unit}} · {{item.direction_label}}</view><view class="line">最近 {{item.last_sample_value}}{{item.unit}} · {{item.last_triggered_at}}</view><view class="muted">{{item.source_label}} · 点此查看详情和处理过程</view></view><button wx:if="{{items.length &lt; total}}" bindtap="next" disabled="{{busy}}">下一页</button><button bindtap="logout">退出当前登录</button></view>
