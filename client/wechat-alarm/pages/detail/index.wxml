<view class="page"><view wx:if="{{busy}}">正在读取…</view><view class="error">{{error}}</view><button bindtap="refresh" disabled="{{busy}}">刷新或重试</button><view wx:if="{{event}}" class="card"><view class="title">{{event.greenhouse_name}}（{{event.greenhouse_code}}）</view><view class="line">事件{{event.id}} · {{event.metric_label}} · {{event.state_label}}</view><view class="line">首次触发 {{event.first_sample_value}}{{event.unit}} · {{event.first_triggered_at}}</view><view class="line">阈值下限 {{event.lower_label}}，上限 {{event.upper_label}} · 规则{{event.first_rule_id}}</view><view class="line">方向 {{event.direction_label}} · 来源 {{event.source_label}}</view><view class="line">设备 {{event.first_device_code}} · 样本{{event.first_sample_id}}</view><view class="line">最近异常 {{event.last_sample_value}}{{event.unit}} · {{event.last_triggered_at}} · {{event.abnormal_count}}次</view><view class="line">最近规则{{event.last_rule_id}} 下限{{event.last_lower_label}} 上限{{event.last_upper_label}}</view><view wx:if="{{event.original_sample_changed}}" class="error">原样本已变更，历史触发快照保持原证据</view><view class="line">确认人 {{event.confirmed_name || '尚未确认'}} {{event.confirmed_at || ''}}</view><view class="line">{{event.close_label}} {{event.closed_name || ''}} {{event.closed_at || ''}}</view><view class="line">{{event.close_note || ''}}</view><view wx:if="{{event.recovery_sample_id}}" class="line">恢复样本{{event.recovery_sample_id}} · {{event.recovery_value}}{{event.unit}} · {{event.recovery_time}}</view><view class="title">处理过程</view><view wx:if="{{!event.actions.length}}">暂无处理记录</view><view wx:for="{{event.actions}}" wx:key="id" class="line">{{item.created_at}} {{item.actor_name}}：{{item.note}}</view><view class="muted">本页只读。PC处理后刷新可同步状态；报警关闭不表示设备控制已执行。</view></view></view>
