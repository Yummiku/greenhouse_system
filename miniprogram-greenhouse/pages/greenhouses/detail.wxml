<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{loading}}">读取中…</view><view wx:if="{{greenhouse}}" class="card"><view>{{greenhouse.name}} · {{greenhouse.greenhouse_code}}</view><view>{{greenhouse.location}}</view><view>面积 {{greenhouse.area}} 平方米 · 负责人 {{greenhouse.manager_name}}</view><view>{{greenhouse.status==='enabled'?'启用':'停用'}}</view></view><view>所属设备</view><view wx:if="{{!loading&&!error&&devices.length===0}}">暂无绑定设备</view><view wx:for="{{devices}}" wx:key="device_pk" class="card"><view>{{item.device_name}} · {{item.device_code}}</view><view>{{item.device_type==='sensor'?'传感器':'控制设备'}} · {{item.metric_label}} · {{item.unit_label}}</view></view></view>
