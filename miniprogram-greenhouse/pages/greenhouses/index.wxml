<view class="page"><view class="toolbar"><button bindtap="login" disabled="{{loading}}">微信登录</button><button bindtap="bind">扫码绑定本人平台账号</button><input placeholder="大棚名称或编号" value="{{keyword}}" bindinput="onKeyword"/><button bindtap="search" disabled="{{loading}}">查询</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重试</button></view><view wx:if="{{loading}}">读取中…</view><view wx:if="{{!loading&&!error&&items.length===0}}">暂无符合条件的大棚</view><view wx:for="{{items}}" wx:key="id" class="card" bindtap="detail" data-id="{{item.id}}"><view>{{item.name}} · {{item.greenhouse_code}}</view><view>{{item.location}}</view><view>{{item.status==='enabled'?'启用':'停用'}}</view></view><button wx:if="{{items.length<total}}" bindtap="next" disabled="{{loading}}">下一页</button></view>
