<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html lang="zh-CN"><meta charset="UTF-8"><title>大棚档案管理</title>
<link rel="stylesheet" href="../../assets/css/bootstrap.min.css">
<style>body{padding:24px;background:#f4f7f5;color:#183d30}section{background:white;padding:20px;margin:16px 0;border-radius:10px}input,select,button{padding:8px;margin:4px}table{width:100%}td,th{padding:10px;border-bottom:1px solid #ddd}dialog{max-width:760px;border:1px solid #bbb;border-radius:10px}label{display:inline-block;margin:8px}#msg{white-space:pre-wrap}pre{white-space:pre-wrap}@media print{.controls,button,dialog{display:none!important}body{background:white;padding:0}section{margin:0}#printinfo{display:block!important}}</style>
<h1>大棚档案管理</h1><p>潘雨希 · XM06 · 第十二周</p>
<section class="controls"><form id="filter"><input name="keyword" placeholder="名称或编号"><input name="location" placeholder="位置"><select name="manager_id" id="managerFilter"><option value="">全部负责人</option></select><select name="status"><option value="">全部状态</option><option value="enabled">启用</option><option value="disabled">停用</option></select><select name="sort"><option value="created_at">创建时间</option><option value="greenhouse_code">编号</option><option value="area">面积</option></select><select name="dir"><option value="desc">降序</option><option value="asc">升序</option></select><button>查询</button></form><button id="add">新增大棚</button><button id="export">导出全部筛选结果</button><button id="print">打印预览</button></section>
<p id="msg" role="status"></p><section id="stats"></section><p id="printinfo" style="display:none"></p><section><table><thead><tr><th>编号</th><th>名称</th><th>位置</th><th>面积 m²</th><th>负责人</th><th>状态</th><th class="controls">操作</th></tr></thead><tbody id="rows"></tbody></table><div class="controls"><button id="prev">上一页</button><span id="pages"></span><button id="next">下一页</button></div></section>
<dialog id="edit"><h2>大棚档案</h2><form id="editor"><input type="hidden" name="id"><label>编号<input name="greenhouse_code" required maxlength="64"></label><label>名称<input name="name" required maxlength="100"></label><label>位置<input name="location" required maxlength="255"></label><label>面积(m²)<input name="area" type="number" min="0.01" step="0.01" required></label><label>长度(m)<input name="length" type="number" min="0.01" step="0.01" required></label><label>宽度(m)<input name="width" type="number" min="0.01" step="0.01" required></label><label>负责人<select name="manager_id" id="managerEdit" required></select></label><label>状态<select name="status"><option value="enabled">启用</option><option value="disabled">停用</option></select></label><label>备注<input name="remark" maxlength="1000"></label><p>面积独立保存，不按长×宽覆盖。</p><button>保存</button><button type="button" onclick="document.getElementById('edit').close()">取消</button><p id="formmsg"></p></form></dialog>
<dialog id="detail"><h2>档案详情</h2><pre id="detailtext"></pre><button onclick="document.getElementById('detail').close()">关闭</button></dialog>
<script>window.GH_CONTEXT_PATH='<%=request.getContextPath()%>';</script><script src="../../assets/app/js/app-api.js"></script>
<script>
const $=id=>document.getElementById(id), api=(a,p={})=>GHApi.get('/api/greenhouses',{action:a,...p});
let applied={},pageNo=1,total=0,canWrite=false;
function text(id,t){$(id).textContent=t}function conditions(){return JSON.stringify(applied)}
function render(items){$('rows').replaceChildren();items.forEach(r=>{const tr=document.createElement('tr');['greenhouse_code','name','location','area','manager_name','status'].forEach(k=>{let td=document.createElement('td');td.textContent=k==='status'?(r[k]==='enabled'?'启用':'停用'):r[k];tr.append(td)});let td=document.createElement('td');td.className='controls';function btn(t,fn){let b=document.createElement('button');b.textContent=t;b.onclick=()=>fn().catch(e=>text('msg',e.message));td.append(b)}btn('详情',async()=>{const x=await api('detail',{id:r.id});text('detailtext',Object.entries(x.data).map(([k,v])=>k+'：'+v).join('\n'));$('detail').showModal()});if(canWrite){btn('编辑',async()=>{const x=await api('detail',{id:r.id});$('editor').reset();Object.entries(x.data).forEach(([k,v])=>{if($('editor').elements[k])$('editor').elements[k].value=v??''});text('formmsg','');$('edit').showModal()});btn('删除',async()=>{if(confirm('确认逻辑删除？有关联时须使用停用。')){await GHApi.post('/api/greenhouses',{action:'delete',id:r.id});await load()}})}tr.append(td);$('rows').append(tr)});}
async function load(){text('msg','加载中…');try{const [r,s]=await Promise.all([api('list',{...applied,page:pageNo}),api('stats',applied)]);total=Number(r.data.total);render(r.data.items);text('stats',`当前筛选：${s.data.total} 座，总面积 ${s.data.area} m²，启用 ${s.data.enabled} 座，停用 ${s.data.disabled} 座`);text('pages',`第 ${pageNo} 页 / 共 ${total} 条`);$('prev').disabled=pageNo===1;$('next').disabled=pageNo*10>=total;text('msg',total?'查询成功':'暂无符合条件的大棚')}catch(e){text('msg',e.message)}}
$('filter').onsubmit=e=>{e.preventDefault();applied=Object.fromEntries(new FormData(e.target));pageNo=1;load()};$('prev').onclick=()=>{pageNo--;load()};$('next').onclick=()=>{pageNo++;load()};$('add').onclick=()=>{$('editor').reset();$('editor').elements.id.value='';text('formmsg','');$('edit').showModal()};
$('editor').onsubmit=async e=>{e.preventDefault();const p=Object.fromEntries(new FormData(e.target));try{await GHApi.post('/api/greenhouses',{...p,action:p.id?'update':'create'});$('edit').close();await load()}catch(e){text('formmsg',e.message)}};
$('export').onclick=()=>{location.href=GH_CONTEXT_PATH+'/api/greenhouses?'+new URLSearchParams({...applied,action:'export'})};
$('print').onclick=async()=>{try{text('msg','正在准备全部筛选记录…');let items=[],p=1,r;do{r=await api('list',{...applied,page:p++,size:100});items.push(...r.data.items)}while(items.length<Number(r.data.total));render(items);text('printinfo','筛选条件：'+conditions()+'；打印时间：'+new Date().toLocaleString('zh-CN',{timeZone:'Asia/Shanghai'})+'；操作人：以当前登录账号为准');window.print();await load()}catch(e){text('msg',e.message)}};
(async()=>{try{const r=await api('context');canWrite=r.data.role!=='3';$('add').hidden=!canWrite;r.data.users.forEach(u=>{for(const id of ['managerFilter','managerEdit']){const o=document.createElement('option');o.value=u.id;o.textContent=u.display_name;$(id).append(o)}});await load()}catch(e){text('msg',e.message)}})();
</script></html>
